      "parameters": {
        "chatId": "={{ $('Settings Map').first().json.telegram_chat_id || '' }}",
        "text": "=SENT {{ $('One At A Time').item.json.action === 'invoice' ? 'INVOICE' : 'UPSELL PITCH' }} to {{ $('One At A Time').item.json.name }} for {{ $('One At A Time').item.json.price }}. Money moves when they pay - watch your Zelle inbox.",
        "additionalFields": {}
