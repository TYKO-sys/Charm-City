{
  "name": "04 - Deal Closer (invoices + upsell)",
  "nodes": [
    {
      "id": "ccs04-01",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-420, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "ccs04-02",
      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [-160, 0],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "__SHEET_ID__",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "credentials": {
        "Charm City Google": {
          "id": "ccs-google",
          "name": "Charm City Google"
        }
      }
    },
    {
      "id": "ccs04-03",
      "name": "Read Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [-160, 200],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "__SHEET_ID__",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "options": {}
      },
      "credentials": {
        "Charm City Google": {
          "id": "ccs-google",
          "name": "Charm City Google"
        }
      }
    },
    {
      "id": "ccs04-04",
      "name": "Settings Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 200],
      "parameters": {
        "jsCode": "const out = {};\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (j.key !== undefined && String(j.key).trim() !== '') {\n    out[String(j.key).trim()] = String(j.value === undefined ? '' : j.value).trim();\n  }\n}\nreturn [{ json: out }];"
      }
    },
    {
      "id": "ccs04-05",
      "name": "Find Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 0],
      "parameters": {
        "jsCode": "const s = $('Settings Map').first().json;\nconst today = new Date();\nconst iso = today.toISOString().slice(0, 10);\nconst plusDays = (dstr, n) => {\n  const x = new Date(String(dstr) + 'T00:00:00Z');\n  x.setUTCDate(x.getUTCDate() + n);\n  return x.toISOString().slice(0, 10);\n};\nconst due = plusDays(iso, 3);\nconst rows = $input.all().map(i => i.json).filter(Boolean);\nconst acts = [];\nfor (const r of rows) {\n  const st = String(r.outreach_status === undefined ? '' : r.outreach_status || '').toLowerCase();\n  if (st !== 'won') continue;\n  const email = String(r.email || '').trim();\n  if (!email) continue;\n  const name = String(r.business_name || 'there');\n  const price = String(r.price_quoted || s.price_default || '$500');\n  const site = String(r.site_url || '');\n  if (String(r.invoice_sent || '').toLowerCase() !== 'yes') {\n    acts.push({\n      action: 'invoice', id: String(r.id === undefined ? '' : r.id), to: email, name: name, price: price, today: iso,\n      subject: 'Invoice from Charm City Sites - ' + name + ' website',\n      body: 'Hi ' + name + ',\\n\\nGreat working with you. Invoice details:\\n\\n' +\n        '  What: One small-business website' + (site ? ' (' + site + ')' : '') + ', mobile-first, Google-ready, contact form wired to your inbox\\n' +\n        '  Price: ' + price + '\\n  Due: ' + due + '\\n\\n' +\n        'Payment options:\\n' +\n        '  - Zelle to ' + String(s.operator_email || '') + ' (fastest, no fees)\\n' +\n        '  - Check mailed to ' + String(s.operator_address || '[ask me for the mailing address]') + '\\n' +\n        (s.paypal_note ? '  - ' + s.paypal_note + '\\n' : '') +\n        '\\nOnce payment clears I move everything into your name and the form starts landing leads in your inbox.\\n\\n' +\n        'Thanks,\\n' + String(s.operator_name || 'Charm City Sites') + '\\nCharm City Sites, Baltimore'\n    });\n  } else if (String(r.upsell_sent || '').toLowerCase() !== 'yes') {\n    const sentAt = String(r.invoice_sent_at || '');\n    if (sentAt && plusDays(sentAt, 2) <= iso) {\n      acts.push({\n        action: 'upsell', id: String(r.id === undefined ? '' : r.id), to: email, name: name, price: '$400', today: iso,\n        subject: 'One more thing for ' + name + ' - never miss a call again',\n        body: 'Hi ' + name + ',\\n\\nQuick idea while the site settles in.\\n\\n' +\n          'Most trades miss a good chunk of calls mid-job, and every missed call is a job walking to the next name on Google.\\n\\n' +\n          'For $400 one-time I set up missed-call text-back: someone calls, you are elbow-deep in a drain, they instantly get a text - ' +\n          '\"Thanks for calling ' + name + ', we are on a job right now - what do you need?\" - with your site link. They reply, the job is still yours.\\n\\n' +\n          'Works with your existing number, takes me a day.\\n\\nWant it?\\n\\n' +\n          String(s.operator_name || 'Charm City Sites') + '\\nCharm City Sites, Baltimore'\n      });\n    }\n  }\n}\nreturn acts.map(a => ({ json: a }));"
      }
    },
    {
      "id": "ccs04-06",
      "name": "One At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [320, 0],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "ccs04-07",
      "name": "Send Action Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [560, 0],
      "parameters": {
        "fromEmail": "={{ $('Settings Map').first().json.operator_email }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {}
      },
      "credentials": {
        "Charm City Email": {
          "id": "ccs-email",
          "name": "Charm City Email"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "ccs04-08",
      "name": "Is Invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 0],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.action }}",
              "value2": "invoice"
            }
          ]
        }
      }
    },
    {
      "id": "ccs04-09",
      "name": "Update Invoice Done",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1040, -80],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "__SHEET_ID__",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('One At A Time').item.json.id }}",
            "invoice_sent": "yes",
            "invoice_sent_at": "={{ $('One At A Time').item.json.today }}"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "Charm City Google": {
          "id": "ccs-google",
          "name": "Charm City Google"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "ccs04-10",
      "name": "Update Upsell Done",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1040, 120],
