    {
      "id": "ccs02-18",
      "name": "Handle Status Or List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 220],
      "parameters": {
        "jsCode": "const c = $('Handle Command').item.json;\nconst rows = $input.all().map(i => i.json).filter(Boolean);\nconst today = new Date().toISOString().slice(0, 10);\nif (c.cmd === 'status') {\n  const row = rows.find(r => String(r.id === undefined ? '' : r.id).trim() === String(c.id).trim());\n  if (!row) return [{ json: { needs_update: false, text: 'No row with id ' + c.id + '. Send /leads to see ids.', chat: c.chat } }];\n  return [{ json: {\n    needs_update: true, id: c.id, status: c.status, today: today, chat: c.chat,\n    text: 'Lead ' + c.id + ' (' + row.business_name + ') -> ' + c.status.toUpperCase() + ' [' + today + ']'\n  } }];\n}\nconst last = rows.slice(-10).reverse();\nconst lines = last.map(r => '#' + r.id + ' ' + r.business_name + ' - ' + (r.outreach_status || 'new') + (r.site_url ? ' - ' + r.site_url : ''));\nreturn [{ json: { needs_update: false, text: 'Last ' + last.length + ' leads:\\n' + lines.join('\\n'), chat: c.chat } }];"
      }
    },
