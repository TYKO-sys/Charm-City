      "id": "ccs02-13",
      "name": "Read Leads For Dedupe",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [540, 0],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "__SHEET_ID__",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
