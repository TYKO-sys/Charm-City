    {
      "id": "ccs02-06",
      "name": "Settings Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 20],
      "parameters": {
        "jsCode": "const out = {};\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (j.key !== undefined && String(j.key).trim() !== '') {\n    out[String(j.key).trim()] = String(j.value === undefined ? '' : j.value).trim();\n  }\n}\nreturn [{ json: out }];"
      }
    },
    {
      "id": "ccs02-07",
      "name": "Normalize OSM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, -340],
      "parameters": {
        "jsCode": "const els = ($json.elements || []);\nconst out = [];\nfor (const el of els) {\n  const t = el.tags || {};\n  if (!t.name) continue;\n  out.push({\n    business_name: t.name,\n    phone: t.phone || t['contact:phone'] || '',\n    email: t.email || t['contact:email'] || '',\n    website: t.website || t['contact:website'] || '',\n    address: [t['addr:housenumber'], t['addr:street'], t['addr:city'] || 'Baltimore', t['addr:state'] || 'MD'].filter(Boolean).join(' '),\n    neighborhood: t['addr:suburb'] || t['addr:neighbourhood'] || '',\n    source: 'osm'\n  });\n}\nreturn out.map(x => ({ json: x }));"
      }
    },
    {
      "id": "ccs02-08",
      "name": "Normalize Push",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, -40],
      "parameters": {
        "jsCode": "const j = $json.body || $json;\nconst lead = {\n  business_name: String(j.business_name || '').trim(),\n  phone: String(j.phone || '').trim(),\n  email: String(j.email || '').trim(),\n  website: String(j.website || '').trim(),\n  address: String(j.address || '').trim(),\n  neighborhood: String(j.neighborhood || '').trim(),\n  source: String(j.source || 'push').trim()\n};\nreturn [{ json: lead }];"
      }
    },
    {
      "id": "ccs02-09",
      "name": "Handle Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 300],
      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst text = String(msg.text || '').trim();\nconst chat = msg.chat && msg.chat.id ? String(msg.chat.id) : '';\nconst from = msg.from && msg.from.username ? '@' + msg.from.username : (msg.from && msg.from.first_name ? msg.from.first_name : 'you');\nconst lc = text.toLowerCase();\nconst HELP = 'Charm City Sites control:\\n' +\n  '/add Business Name | 410-555-0101 | neighborhood - queue a lead\\n' +\n  '/leads - last 10 rows with their ids\\n' +\n  '/status <id> <new|sent|replied|won|dead> - update a lead\\n' +\n  'Your chat id: ' + chat + ' (paste it into the Settings tab if alerts ever go silent)\\n' +\n  'Everything else runs itself.';\nif (lc.startsWith('/add')) {\n  const parts = text.replace(/^\\/add\\s*/i, '').split('|').map(s => s.trim());\n  const lead = {\n    business_name: parts[0] || '',\n    phone: parts[1] || '',\n    email: (parts[2] || '').includes('@') ? parts[2] : '',\n    website: '',\n    address: '',\n    neighborhood: (parts[2] && !String(parts[2]).includes('@')) ? parts[2] : (parts[3] || ''),\n    source: 'telegram:' + from\n  };\n  if (!lead.business_name) return [{ json: { route: 'reply', text: 'Usage: /add Business Name | 410-555-0101 | neighborhood', chat: chat } }];\n  return [{ json: { route: 'lead', lead: lead, chat: chat } }];\n}\nif (lc.startsWith('/leads')) return [{ json: { route: 'sheet', cmd: 'list', chat: chat } }];\nconst m = text.match(/^\\/status\\s+(\\S+)\\s+(\\w+)/i);\nif (m) {\n  const st = m[2].toLowerCase();\n  const allowed = ['new', 'sent', 'replied', 'won', 'dead', 'warm', 'lost'];\n  if (!allowed.includes(st)) return [{ json: { route: 'reply', text: 'Status must be one of: ' + allowed.join(', '), chat: chat } }];\n  return [{ json: { route: 'sheet', cmd: 'status', id: m[1], status: st, chat: chat } }];\n}\nreturn [{ json: { route: 'reply', text: HELP, chat: chat } }];"
      }
    },
