    {
      "id": "ccs02-14",
      "name": "Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0],
      "parameters": {
        "jsCode": "const grab = (name) => {\n  try { return $(name).all().map(i => i.json).filter(Boolean); } catch (e) { return []; }\n};\nlet cands = [];\nfor (const x of grab('Normalize OSM')) cands.push(x);\nfor (const x of grab('Normalize Push')) cands.push(x);\nfor (const x of grab('Handle Command')) cands.push(x.lead ? x.lead : null);\ncands = cands.filter(Boolean);\nconst rows = $input.all().map(i => i.json).filter(Boolean);\nconst key = (r) => {\n  const tel = String(r.phone || '').replace(/\\D/g, '');\n  const dom = String(r.website || '').toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0];\n  const nam = String(r.business_name || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n  if (tel.length >= 10) return 'tel:' + (tel.length === 11 && tel[0] === '1' ? tel.slice(1) : tel);\n  if (dom) return 'dom:' + dom;\n  if (nam) return 'nam:' + nam;\n  return null;\n};\nconst existing = new Set(rows.map(key).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const c of cands) {\n  if (!c.business_name) continue;\n  const k = key(c);\n  if (!k || existing.has(k) || seen.has(k)) continue;\n  seen.add(k);\n  out.push(c);\n}\nreturn out.map(x => ({ json: x }));"
      }
    },
