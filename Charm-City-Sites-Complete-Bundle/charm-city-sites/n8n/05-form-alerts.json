          }
        ]
      ]
    },
    "Matched?": {
      "main": [
        [
          {
            "node": "Update Replied",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignore Other Mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Replied": {
      "main": [
        [
          {
            "node": "Alert Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
